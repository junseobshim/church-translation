# Credentials & secrets
.env
live-api-keys.txt

# JSON credentials
*.json
# …except the tunnel→hostname map, which holds no secrets and must ship to every
# volunteer machine or the control panel can't build phone links.
!tunnels.json

# Python
__pycache__/
*.pyc
venv/

# macOS
.DS_Store

# Claude Code
.claude/


# Cloudflare Workers
worker/.wrangler/

# Apps (for one click launch)
*.app

# Swift package build artifacts + staged Python runtime (app/build/stage_python.sh output)
app/.build/
app/.build-cache/
app/Resources/
app/build/*.dmg
app/build/.dmg-staging/
# Stray swiftc intermediates that sometimes land at app/ root instead of
# .build/ when incremental compilation gets confused (harmless, regenerable).
app/*.d
app/*.o
app/*.swiftdeps
app/*.swiftdeps~